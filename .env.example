# 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요. .env 는 Git 에 올라가지 않습니다.
# 키를 비워 두면 데모 모드(비용 0원)로만 실행됩니다.

# Claude API 키 (https://console.anthropic.com 에서 발급, 사용량만큼 과금)
ANTHROPIC_API_KEY=

# 사용할 모델. 비워 두면 claude-opus-5-5
# 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
CLAUDE_MODEL=

# 실제 AI 모드에 들어갈 때 요구할 비밀번호(공개 배포 시 반드시 설정)
APP_PASSWORD=

# 한 브라우저 세션에서 허용할 최대 AI 호출 수(상품 1개 = 3회)
LIVE_CALL_LIMIT=9
